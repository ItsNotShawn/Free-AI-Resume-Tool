# Copy to .env.local and fill in. Never commit real values.

# Supabase → Project Settings → API
# Bare project URL only: no /rest/v1, no trailing slash.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Where magic links send people back to (no trailing slash).
# Local: http://localhost:3000   Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI structuring (milestone 3+). Server-only: never prefix with NEXT_PUBLIC_.
# Get a key at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=
